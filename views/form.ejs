<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1><%= title %></h1>
  
  <form method="POST" action="/new">
    <div>
      <label for="user">Author Name:</label><br>
      <input type="text" id="user" name="messageUser" required>
    </div>
    <br>
    <div>
      <label for="text">Message text:</label><br>
      <textarea id="text" name="messageText" rows="4" cols="30" required></textarea>
    </div>
    <br>
    <button type="submit">Submit</button>
  </form>
  
  <br>
  <a href="/">Back to Board</a>
</body>
</html>
